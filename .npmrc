# pnpm settings for a React Native / Expo monorepo.
#
# `node-linker=hoisted` gives the dependency tree the flat layout Metro expects.
# pnpm's default isolated (symlinked) node_modules is the single most common
# cause of "Unable to resolve module" in an Expo workspace. The trade-off is
# weaker dependency isolation — an acceptable price for a working mobile build.
node-linker=hoisted

# Keep the store inside the repo so CI caches are predictable.
# store-dir=.pnpm-store

strict-peer-dependencies=false
