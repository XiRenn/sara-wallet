# ── Dependencies ──────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build output ──────────────────────────────────────────────────────────
dist/
build/
out/
release/
*.tsbuildinfo

# ── Expo / React Native ───────────────────────────────────────────────────
.expo/
.expo-shared/
apps/mobile/ios/
apps/mobile/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ── Environment ───────────────────────────────────────────────────────────
# Never commit real credentials. `.env.example` files are tracked on purpose.
.env
.env.local
.env.*.local
!.env.example

# ── Logs & OS noise ───────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Local scratch ─────────────────────────────────────────────────────────
# Python venv for scripts/check-sql.py, and a scratch dir for throwaway probes.
.venv/
.venv-sql/
venv/
.pgtmp/
# Fallback install tree for scripts/check-sql-live.mjs, used when installing
# into the workspace is not possible. See that script's header.
.tools/

# Local agent/workspace state
.workbuddy-ai/

# Temporary files created by tools and test runs
_tmp_*
*.tmp
*.temp

# ── Design review ─────────────────────────────────────────────────────────
# `apps/desktop/design/preview.html` and `.review/verify-preview.mjs` are
# tracked — the preview is a deliverable and the suite is a regression test.
# The screenshots it writes are regenerable output.
.review/*.png
# Compiler output for `.review/hue-check.mjs`, which compiles the mobile theme
# so it can assert the avatar colours against the real source rather than a copy.
.review/_huecheck/

# Vite/Vitest generated config snapshots
**/*.timestamp-*.mjs

# ── Supabase CLI ──────────────────────────────────────────────────────────
supabase/.branches/
supabase/.temp/

# Generated by `pnpm migrations:bundle` — a concatenation of
# supabase/migrations/*.sql for a single paste into the SQL Editor. Generated,
# never edited: the migrations stay the source of truth. `apply-from-*.sql` is
# the `--from` variant, for a project that is only partially migrated.
supabase/apply-*.sql
