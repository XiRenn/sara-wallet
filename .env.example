# ============================================================================
#  Sara Wallet — environment template
#
#  Copy this file to `.env` at the repo root for tooling that reads it, and
#  copy the per-app blocks into `apps/mobile/.env` and `apps/desktop/.env`.
#
#  All three clients ship the **anon** key to the device. Row Level Security is
#  what actually protects the data. The service-role key must never appear in
#  any file an app bundle can reach.
# ============================================================================

# ── Shared (scripts, migrations, tooling) ──────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side only. Never expose this to a client.
SUPABASE_SERVICE_ROLE_KEY=

# ── apps/mobile  (Expo inlines EXPO_PUBLIC_* into the bundle) ──────────────
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── apps/desktop (Vite inlines VITE_* into the renderer bundle) ────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
